-- Table to keep track of highlights we are monitoring
local monitored = {}

-- Check if a highlight's Adornee (target) is the player's character (or part of it)
local function adorneeIsPlayerCharacter(highlight)
    if not highlight then return false end

    local adornee = highlight.Adornee
    local character = player.Character

    if not adornee or not character then
        return false
    end

    -- If adornee is the character model itself
    if adornee == character then
        return true
    end

    -- If adornee is a descendant part inside the character (e.g., a limb)
    if adornee:IsDescendantOf(character) then
        return true
    end

    return false
end

-- Safely connect to a property changed signal, returning the connection if successful
local function safeConnectPropertyChanged(instance, propertyName, callback)
    local success, signal = pcall(function()
        return instance:GetPropertyChangedSignal(propertyName)
    end)

    if success and signal then
        return signal:Connect(callback)
    end

    return nil
end

-- Monitor a single Highlight object to detect when it starts/stops adorning the player
local function monitorHighlight(highlight)
    if not highlight or monitored[highlight] then
        return
    end

    monitored[highlight] = true
    local prevState = adorneeIsPlayerCharacter(highlight)
    local connections = {}

    -- Cleanup connections when highlight is removed or no longer relevant
    local function cleanup()
        for _, conn in ipairs(connections) do
  if conn and conn.Connected then
      conn:Disconnect()
  end
        end
        monitored[highlight] = nil
    end

    -- Called whenever the Adornee property or related ancestry changes
    local function onChanged()
        if not highlight or not highlight.Parent then
  cleanup()
  return
        end

        local currState = adorneeIsPlayerCharacter(highlight)

        -- If the adornee changed from player to non-player or vice versa
        if prevState ~= currState then
  if currState then
      print("Highlight's Adornee is PLAYER ->", highlight:GetFullName())

      -- Simulate pressing and releasing the space key
      pcall(function()
keypress(Enum.KeyCode.Space)
wait(0.01)
keyrelease(Enum.KeyCode.Space)
      end)
  else
      print("Highlight's Adornee is NOT player ->", highlight:GetFullName())
      -- Optional: add logic here if needed when highlight is removed from player
  end
        end

        prevState = currState
    end

    -- Connect to Adornee property changes
    local adChangeConn = safeConnectPropertyChanged(highlight, "Adornee", onChanged)
    if adChangeConn then
        table.insert(connections, adChangeConn)
    end

    -- Connect to ancestry changes (in case highlight or adornee is moved or destroyed)
    table.insert(connections, highlight.AncestryChanged:Connect(function(_, parent)
        if not parent then
  cleanup()
        else
  onChanged()
        end
    end))

    -- Listen for player's character being added or removed to re-check highlight state
    table.insert(connections, player.CharacterAdded:Connect(onChanged))
    table.insert(connections, player.CharacterRemoving:Connect(onChanged))

    -- Run the check immediately once
    task.spawn(onChanged)
end

-- Initially monitor all existing highlights in the behavior folder
for _, descendant in ipairs(behaviorFolder:GetDescendants()) do
    if descendant:IsA("Highlight") then
