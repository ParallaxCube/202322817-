local shootGui, blockGui = nil, nil

local function createChanceGUIs()
	if shootGui or blockGui then return end

	-- ========== Shoot GUI ==========
	local player = lp
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	shootGui = Instance.new("ScreenGui")
	shootGui.Name = "ShootGui"
	shootGui.ResetOnSpawn = false
	shootGui.Parent = player:WaitForChild("PlayerGui")

	local shootButton = Instance.new("TextButton")
	shootButton.Name = "ShootButton"
	shootButton.Size = UDim2.new(0, 150, 0, 60)
	shootButton.Position = UDim2.new(0.5, 0, 0.92, 0)
	shootButton.AnchorPoint = Vector2.new(0.5, 0.5)
	shootButton.BackgroundColor3 = Color3.fromRGB(75, 0, 130)
	shootButton.BackgroundTransparency = 0.4
	shootButton.Text = "Shoot"
	shootButton.TextColor3 = Color3.new(1, 1, 1)
	shootButton.TextScaled = true
	shootButton.Parent = shootGui

	local uiCorner = Instance.new("UICorner")
	uiCorner.CornerRadius = UDim.new(0, 12)
	uiCorner.Parent = shootButton

	local dragging, dragStartPos, startPos
	shootButton.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStartPos = input.Position
			startPos = shootButton.Position
		end
	end)

	shootButton.InputChanged:Connect(function(input, processed)
		if not dragging or processed then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStartPos
			shootButton.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	shootButton.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	local canShoot = true
	local cooldown = 0.8

	local function buildArgs()
		local x, y, z = 0.08853239566087723, -0.000001093038576982508, 0.996073305606842
		local vec = Vector3.new(x, y, z)
		return { player.Name .. "ChanceFireShot", { vec } }
	end

	shootButton.Activated:Connect(function()
		if not canShoot then return end
		canShoot = false
		local args = buildArgs()

		local success, err = pcall(function()
			ReplicatedStorage
				:WaitForChild("Modules")
				:WaitForChild("Network")
				:WaitForChild("RemoteEvent")
				:FireServer(unpack(args))
		end)

		if not success then
			warn("Failed to FireServer:", err)
		end

		task.wait(cooldown)
		canShoot = true
	end)

	-- ========== Block GUI ==========
	local UserInputService = game:GetService("UserInputService")
	local playerGui = player:WaitForChild("PlayerGui")
	local remotePath = ReplicatedStorage:FindFirstChild("Modules") and
					   ReplicatedStorage.Modules:FindFirstChild("Network") and
					   ReplicatedStorage.Modules.Network:FindFirstChild("RemoteEvent")

	blockGui = Instance.new("ScreenGui")
	blockGui.Name = "BlockGui"
	blockGui.Parent = playerGui
	blockGui.ResetOnSpawn = false
	blockGui.DisplayOrder = 10

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 150, 0, 75)
	frame.Position = UDim2.new(0.5, -400, 0.5, -150.5)
	frame.BackgroundColor3 = Color3.fromRGB(75, 0, 130)
	frame.BackgroundTransparency = 0.5
	frame.Parent = blockGui
	frame.Active = true
	frame.Selectable = true

	local uiCorner2 = Instance.new("UICorner")
	uiCorner2.CornerRadius = UDim.new(0, 10)
	uiCorner2.Parent = frame

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 1, 0)
	button.BackgroundTransparency = 1
	button.Text = "Block"
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextScaled = true
	button.Parent = frame

	local dragging = false
	local dragStartPos
	local frameStartPos

	frame.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStartPos = input.Position
			frameStartPos = frame.Position
		end
	end)

	frame.InputChanged:Connect(function(input, gameProcessed)
		if not dragging or gameProcessed then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStartPos
			frame.Position = UDim2.new(
				frameStartPos.X.Scale,
				frameStartPos.X.Offset + delta.X,
				frameStartPos.Y.Scale,
				frameStartPos.Y.Offset + delta.Y
			)
		end
	end)

	frame.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- Script logic (metatable blocking)
	local scriptActive = false
	local debounce = false
	local connection
	local oldNamecall

	local function enableScript()
		if scriptActive or debounce or not remotePath then
			if not remotePath then
				warn("Error: RemoteEvent not found")
			end
			return
		end
		debounce = true
		scriptActive = true
		button.Text = "Blocking..."

		local mt = getrawmetatable(game)
		oldNamecall = mt.__namecall
		setreadonly(mt, false)

		mt.__namecall = function(self, ...)
			if not scriptActive then return oldNamecall(self, ...) end
			if self == remotePath and getnamecallmethod() == "FireServer" then
				local args = {...}
				if #args == 2 and args[1] == player.Name .. "ChanceFireShot" then
					local vector = args[2]
					if type(vector) == "table" and
					   math.abs(vector[1] - 0.08853239566087723) < 1e-6 and
					   math.abs(vector[2] - -0.000001093038576982508) < 1e-6 and
					   math.abs(vector[3] - 0.996073305606842) < 1e-6 then
						print("Blocked specific RemoteEvent call")
						return nil
					end
				end
			end
			return oldNamecall(self, ...)
		end

		setreadonly(mt, true)

		connection = ReplicatedStorage.ChildAdded:Connect(function(child)
			if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
				print("Detected new remote: " .. child:GetFullName())
			end
		end)

		task.spawn(function()
			task.wait(1.5)
			if scriptActive then
				scriptActive = false
				setreadonly(mt, false)
				mt.__namecall = oldNamecall
				setreadonly(mt, true)
				if connection then
					connection:Disconnect()
				end
				button.Text = "Block"
				task.wait(0.5)
				debounce = false
			end
		end)
	end

	button.MouseButton1Click:Connect(function()
		if not debounce then
			task.spawn(enableScript)
		end
	end)
end

