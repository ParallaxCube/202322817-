		while autoCoinflipEnabled do
			pcall(function()
				RemoteEvent:FireServer("UseActorAbility", { buffer.fromstring("\"CoinFlip\"") })
			end)
			task.wait(coinflipDelay)
		end
		coinflipLoop = nil
	end)
