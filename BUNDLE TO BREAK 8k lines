      if char and not manualInvis then
playInvisAnim(char)
      end
  end
        end)
        if originalApplied then pcall(function() originalApplied(data) end) end
    end

    Undetectable.Removed = function(data)
        pcall(function()
  if data.Player == LocalPlayer and not manualInvis then
      stopInvisAnim()
  end
        end)
