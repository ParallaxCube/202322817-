-- // HITBOX DRAGGING TECH (Animation-Based)
------------------------------------------------------------
local KillersFolder = workspace:WaitForChild("Players"):WaitForChild("Killers")
local hitboxDraggingEnabled = false
local Dspeed = 5.6
local Ddelay = 0
local HDT_DETECT_RADIUS = 6
local activeHDT = {}

local function humanoidPlayingAnim(humanoid, animId)
	local ok, tracks = pcall(function() return humanoid:GetPlayingAnimationTracks() end)
	if not ok or not tracks then return false end
	for _, t in ipairs(tracks) do
		local id = tostring(t.Animation and t.Animation.AnimationId or ""):match("%d+")
		if id and id == animId then
			return true
		end
	end
	return false
end

local function setHRPVelocitySafe(hrp, vel)
	if hrp then pcall(function() hrp.Velocity = vel end) end
end

local function startHDTForKiller(killerModel, animId)
	if not hitboxDraggingEnabled or not killerModel or activeHDT[killerModel] then return end
	local hum = killerModel:FindFirstChildOfClass("Humanoid")
	local hrp = killerModel:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end
	activeHDT[killerModel] = true

	task.spawn(function()
		while hitboxDraggingEnabled and humanoidPlayingAnim(hum, animId) do
			local myChar = lp.Character
			local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
			if not myHRP then break end

			if Ddelay > 0 then task.wait(Ddelay) end

			local dist = (hrp.Position - myHRP.Position).Magnitude
			if dist <= HDT_DETECT_RADIUS then
				local dir = (hrp.Position - myHRP.Position).Unit
				myHRP.Velocity = dir * math.max(1, Dspeed * 10)
			else
				myHRP.Velocity = Vector3.zero
			end

			task.wait(0.03)
		end

		local myChar = lp.Character
		local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if myHRP then myHRP.Velocity = Vector3.zero end
		activeHDT[killerModel] = nil
	end)
end

