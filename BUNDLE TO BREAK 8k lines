    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = true
    hl.Parent = model

    -- KÃ¡ÂºÂ¿t nÃ¡Â»â€˜i model-level watchers (Ã„â€˜Ã¡Â»Æ’ tÃ¡Â»Â± phÃ¡Â»Â¥c hÃ¡Â»â€œi khi parent thay Ã„â€˜Ã¡Â»â€¢i / respawn / humanoid died)
    local conns = {}

    -- nÃ¡ÂºÂ¿u model bÃ¡Â»â€¹ reparent / removed -> schedule recreate (debounced)
    table.insert(conns, model.AncestryChanged:Connect(function(_, parent)
        -- nÃ¡ÂºÂ¿u model khÃƒÂ´ng cÃƒÂ²n trong workspace, xÃƒÂ³a ESP
        if not model:IsDescendantOf(workspace) then
  -- xÃƒÂ³a ngay (khÃƒÂ´ng recreate khi user tÃ¡ÂºÂ¯t loÃ¡ÂºÂ¡i)
  if ESPManager.Objects[model] and ESPManager.Objects[model].type == typeName then
